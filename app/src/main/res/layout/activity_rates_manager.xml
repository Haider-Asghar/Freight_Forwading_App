<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bkgdpic"
    tools:context=".Rates_Manager">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <RelativeLayout
                android:id="@+id/rl_ratesManagement"
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/img_ivBack"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    app:srcCompat="@drawable/baseline_arrow_back_ios_24"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"/>

                <TextView
                    android:id="@+id/tv_RatesManagement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rates Management"
                    android:textSize="30sp"
                    android:textColor="@color/blue"
                    android:textStyle="bold"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rl_addCountry"
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp"
                android:background="@drawable/outline_border"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tv_addCountry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add New Country and City"
                    android:textColor="@color/blue"
                    android:textSize="20sp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"/>

                <ImageView
                    android:id="@+id/img_addCountry"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:srcCompat="@drawable/baseline_arrow_forward_ios_24" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rl_addRates"
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/outline_border"
                android:layout_marginBottom="12dp" >

                <TextView
                    android:id="@+id/tv_addRates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add New Rates"
                    android:textColor="@color/blue"
                    android:textSize="20sp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"/>

                <ImageView
                    android:id="@+id/img_addRates"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:srcCompat="@drawable/baseline_arrow_forward_ios_24" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rl_updateRates"
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/outline_border"
                android:layout_marginBottom="12dp" >

                <TextView
                    android:id="@+id/tv_updateRates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Update Existing Rates"
                    android:textColor="@color/blue"
                    android:textSize="20sp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"/>

                <ImageView
                    android:id="@+id/img_updateRates"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:srcCompat="@drawable/baseline_arrow_forward_ios_24" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rl_removeRates"
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/outline_border"
                android:layout_marginBottom="12dp" >

                <TextView
                    android:id="@+id/tv_removeRates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Remove Existing Rates"
                    android:textColor="@color/blue"
                    android:textSize="20sp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"/>

                <ImageView
                    android:id="@+id/img_removeRates"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:srcCompat="@drawable/baseline_arrow_forward_ios_24" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rl_removeCity"
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/outline_border"
                android:layout_marginBottom="12dp" >

                <TextView
                    android:id="@+id/tv_removeCity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Remove Existing City"
                    android:textColor="@color/blue"
                    android:textSize="20sp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"/>

                <ImageView
                    android:id="@+id/img_removeCity"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:srcCompat="@drawable/baseline_arrow_forward_ios_24" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rl_removeCountry"
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/outline_border"
                android:layout_marginBottom="12dp" >

                <TextView
                    android:id="@+id/tv_removeCountry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Remove Existing Country"
                    android:textColor="@color/blue"
                    android:textSize="20sp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"/>

                <ImageView
                    android:id="@+id/img_removeCountry"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:srcCompat="@drawable/baseline_arrow_forward_ios_24" />
            </RelativeLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>