<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    card_view:cardCornerRadius="12dp"
    card_view:cardElevation="6dp"
    card_view:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:id="@+id/mainLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/item_normal_bg">

                <!-- Airline / Container -->
                <TextView
                    android:id="@+id/tvAirline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Qatar Airways"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>

                <!-- Freight Highlight -->
                <TextView
                    android:id="@+id/tvFreight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$120 / KG"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#00C853"
                    android:layout_marginTop="6dp"/>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginVertical="8dp"/>

                <!-- DO Charges -->
                <TextView
                    android:id="@+id/tvDo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DO Charges: 5000"
                    android:textSize="14sp"
                    android:textColor="@color/black"/>

                <!-- Transit -->
                <TextView
                    android:id="@+id/tvTransit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Transit: 5 Days"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:layout_marginTop="4dp"/>

                <!-- ExWork -->
                <TextView
                    android:id="@+id/tvExWork"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ExWork: 3000"
                    android:textSize="14sp"
                    android:textColor="#D32F2F"
                    android:layout_marginTop="4dp"/>

        </LinearLayout>

</androidx.cardview.widget.CardView>