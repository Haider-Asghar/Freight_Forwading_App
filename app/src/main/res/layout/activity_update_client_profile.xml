<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bkgdpic"
    tools:context=".Update_Client_Profile">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvUpdateClientProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Update Profile"
                android:textAlignment="center"
                android:textSize="30sp"
                android:textColor="@color/blue"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/companyNameCPLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:hint="Company Name"
                app:boxStrokeColor="@color/blue"
                app:cursorColor="@color/blue"
                app:hintTextColor="@color/blue"
                app:layout_constraintEnd_toEndOf="@+id/tvUpdateClientProfile"
                app:layout_constraintStart_toStartOf="@+id/tvUpdateClientProfile"
                app:layout_constraintTop_toBottomOf="@+id/tvUpdateClientProfile"
                app:startIconDrawable="@drawable/baseline_apartment_24"
                android:clickable="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/companyNameCP"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/emailCPLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Email Address"
                app:boxStrokeColor="@color/blue"
                app:cursorColor="@color/blue"
                app:hintTextColor="@color/blue"
                app:layout_constraintEnd_toEndOf="@+id/companyNameCPLayout"
                app:layout_constraintStart_toStartOf="@+id/companyNameCPLayout"
                app:layout_constraintTop_toBottomOf="@+id/companyNameCPLayout"
                app:startIconDrawable="@drawable/baseline_email_24"
                android:clickable="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/emailCP"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/personNameCPLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Contact Person Name"
                app:boxStrokeColor="@color/blue"
                app:cursorColor="@color/blue"
                app:hintTextColor="@color/blue"
                app:layout_constraintEnd_toEndOf="@+id/emailCPLayout"
                app:layout_constraintStart_toStartOf="@+id/emailCPLayout"
                app:layout_constraintTop_toBottomOf="@+id/emailCPLayout"
                app:startIconDrawable="@drawable/baseline_account_box_24">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/personNameCP"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/contactNoCPLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Contact Number"
                app:boxStrokeColor="@color/blue"
                app:cursorColor="@color/blue"
                app:hintTextColor="@color/blue"
                app:layout_constraintEnd_toEndOf="@+id/personNameCPLayout"
                app:layout_constraintStart_toStartOf="@+id/personNameCPLayout"
                app:layout_constraintTop_toBottomOf="@+id/personNameCPLayout"
                app:placeholderText="0300000000"
                app:startIconDrawable="@drawable/baseline_call_24">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/contactNoCP"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/cnicNoCPLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Cnic Number"
                app:boxStrokeColor="@color/blue"
                app:cursorColor="@color/blue"
                app:hintTextColor="@color/blue"
                app:layout_constraintEnd_toEndOf="@+id/contactNoCPLayout"
                app:layout_constraintStart_toStartOf="@+id/contactNoCPLayout"
                app:layout_constraintTop_toBottomOf="@+id/contactNoCPLayout"
                app:placeholderText="0000000000000"
                app:startIconDrawable="@drawable/baseline_call_to_action_24">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/cnicNoCP"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/companyAddressCPLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Company Address"
                app:boxStrokeColor="@color/blue"
                app:cursorColor="@color/blue"
                app:hintTextColor="@color/blue"
                app:layout_constraintEnd_toEndOf="@+id/cnicNoCPLayout"
                app:layout_constraintStart_toStartOf="@+id/cnicNoCPLayout"
                app:layout_constraintTop_toBottomOf="@+id/cnicNoCPLayout"
                app:startIconDrawable="@drawable/baseline_location_pin_24">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/companyAddressCP"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"/>
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnUpdateClientProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:backgroundTint="@color/blue"
                android:text="Update"
                android:textSize="25sp"
                app:layout_constraintEnd_toEndOf="@+id/companyAddressCPLayout"
                app:layout_constraintStart_toStartOf="@+id/companyAddressCPLayout"
                app:layout_constraintTop_toBottomOf="@+id/companyAddressCPLayout" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>